<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Geometry.UI.Avalonia.ViewModels"
        xmlns:models="using:Geometry.UI.Avalonia.Models"
        xmlns:converters="using:Geometry.UI.Avalonia.Converters"
        x:Class="Geometry.UI.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d"
        Width="900"
        Height="600"
        MinWidth="500"
        MinHeight="300"
        Title="Geometry UI (Avalonia)">
  <Window.Resources>
    <converters:ColorBrushConverter x:Key="ColorBrushConverter" />
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="3" Spacing="6">
        <Separator />
        <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Добавить фигуру" />
        <Separator />

        <ListBox ItemsSource="{Binding AvaiableFigures}" SelectedItem="{Binding SelectedAvailableFigure}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:FigureModel">
              <TextBlock FontSize="16" Text="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Command="{Binding AddFigureCommand}" Content="Добавить фигуру" />

        <Separator Margin="0,10,0,0" />
        <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Список фигур" />
        <Separator />

        <ListBox ItemsSource="{Binding Figures}" SelectedItem="{Binding SelectedFigure}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:FigureModel">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock FontSize="16" Text="{Binding Id}" />
                <TextBlock FontSize="16" Text="{Binding Name}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button Command="{Binding RemoveFigureCommand}" Content="Удалить фигуру" />

        <Separator Margin="0,10,0,0" />
        <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Операции" />
        <Separator />

        <Expander IsEnabled="{Binding IsAvailable}" Header="Масштабирование">
          <StackPanel Margin="0,6,0,0" Spacing="6">
            <TextBox Text="{Binding Scale}" />
            <Button Command="{Binding ChangeScaleCommand}" Content="Масштабировать" />
          </StackPanel>
        </Expander>

        <Expander IsEnabled="{Binding IsAvailable}" Header="Поворот">
          <Grid Margin="0,6,0,0" ColumnDefinitions="*,*,*" RowDefinitions="Auto,*">
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="6">
              <TextBlock HorizontalAlignment="Center" Text="X" />
              <Slider Minimum="-180" Maximum="180" Value="{Binding XAngle}" Orientation="Vertical" Height="200" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="6">
              <TextBlock HorizontalAlignment="Center" Text="Y" />
              <Slider Minimum="-180" Maximum="180" Value="{Binding YAngle}" Orientation="Vertical" Height="200" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="6">
              <TextBlock HorizontalAlignment="Center" Text="Z" />
              <Slider Minimum="-180" Maximum="180" Value="{Binding ZAngle}" Orientation="Vertical" Height="200" />
            </StackPanel>
          </Grid>
        </Expander>

        <Expander IsEnabled="{Binding IsAvailable}" Header="Перенос">
          <Grid Margin="0,6,0,0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Text="X" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TranslateX}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,6,0" Text="Y" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TranslateY}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,6,0" Text="Z" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TranslateZ}" />
            <Button Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Command="{Binding TranslateCommand}" Content="Перенести" />
          </Grid>
        </Expander>

        <Expander IsEnabled="{Binding IsAvailable}" Header="Сдвиг">
          <StackPanel Margin="0,6,0,0" Spacing="6">
            <TextBox Text="{Binding Shear}" />
            <Button Command="{Binding ShearCommand}" Content="Сдвинуть" />
          </StackPanel>
        </Expander>

        <Expander IsEnabled="{Binding IsAvailable}" Header="ОПП">
          <StackPanel Margin="0,6,0,0" Spacing="6">
            <TextBlock FontSize="12" Text="Точка схода на оси +X:" />
            <TextBox Text="{Binding Perspective}" />
            <Button Command="{Binding PerspectiveCommand}" Content="Спроектировать" />
          </StackPanel>
        </Expander>

        <Expander IsEnabled="{Binding IsAvailable}" Header="Вписывание">
          <Grid Margin="0,6,0,0" ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,6" FontSize="12" Text="Координаты области" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="X1" />
            <TextBox Grid.Row="1" Grid.Column="1" Width="60" HorizontalAlignment="Left" Text="{Binding AreaX1}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="6,0,0,0" Text="X2" />
            <TextBox Grid.Row="1" Grid.Column="3" Width="60" HorizontalAlignment="Left" Text="{Binding AreaX2}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Y1" />
            <TextBox Grid.Row="2" Grid.Column="1" Width="60" HorizontalAlignment="Left" Text="{Binding AreaY1}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Margin="6,0,0,0" Text="Y2" />
            <TextBox Grid.Row="2" Grid.Column="3" Width="60" HorizontalAlignment="Left" Text="{Binding AreaY2}" />
            <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                      HorizontalAlignment="Center"
                      IsChecked="{Binding ShowArea}"
                      Content="Показать область" />
            <Button Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Command="{Binding MoveToAreaCommand}" Content="Вписать" />
          </Grid>
        </Expander>

        <Expander IsEnabled="{Binding IsAvailable}" Header="Движение">
          <Grid Margin="0,6,0,0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Text="X" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AnimationX}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,6,0" Text="Y" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AnimationY}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,6,0" Text="Z" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AnimationZ}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Spacing="6">
              <Button Command="{Binding StartAnimationCommand}" Content="Начать движение" />
              <Button Command="{Binding StopAnimationCommand}" Content="Остановить движение" />
            </StackPanel>
          </Grid>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Column="1" Background="WhiteSmoke">
      <Canvas HorizontalAlignment="Center" VerticalAlignment="Center">
        <Rectangle IsVisible="{Binding ShowArea}"
                   Canvas.Left="{Binding AreaX1}"
                   Canvas.Bottom="{Binding AreaY1}"
                   Width="{Binding AreaWidth}"
                   Height="{Binding AreaHeight}"
                   Stroke="Black"
                   StrokeThickness="2"
                   Fill="Aqua"
                   Opacity="0.5" />

        <ItemsControl ItemsSource="{Binding Polygons}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:FacePolygon">
              <Polygon Points="{Binding Points}"
                       Fill="{Binding FillColor, Converter={StaticResource ColorBrushConverter}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Canvas>
    </Grid>
  </Grid>
</Window>
