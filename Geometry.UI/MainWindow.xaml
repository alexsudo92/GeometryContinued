<Window x:Class="Geometry.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Z-buffer Viewport3D"
        Width="1200"
        Height="760"
        MinWidth="980"
        MinHeight="650">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Фигуры" />
                        <TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Foreground="#4B5563"
                               Text="Загрузка фигур из YAML (включая BSP). Для выбранной фигуры доступны аффинные и перспективные преобразования." />
                        <TextBlock FontWeight="SemiBold" Text="Доступные описания" />
                        <ListBox x:Name="AvailableFiguresList" Height="120" Margin="0,8,0,12" DisplayMemberPath="Name" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LoadFigureButton" Width="120" Height="32" Click="LoadFigureButton_OnClick" Content="Добавить" />
                            <Button x:Name="RemoveFigureButton" Margin="8,0,0,0" Width="120" Height="32" Click="RemoveFigureButton_OnClick" Content="Удалить" />
                        </StackPanel>

                        <Separator Margin="0,16,0,16" />
                        <TextBlock FontWeight="SemiBold" Text="Загруженные фигуры" />
                        <ListBox x:Name="LoadedFiguresList" Height="130" Margin="0,8,0,0" DisplayMemberPath="DisplayName" SelectionChanged="LoadedFiguresList_OnSelectionChanged" />

                        <Separator Margin="0,16,0,16" />
                        <TextBlock FontWeight="SemiBold" Text="Преобразования выбранной фигуры" />
                        <TextBlock Margin="0,8,0,0" Text="Масштаб (x y z)" />
                        <TextBox x:Name="ScaleBox" Text="1 1 1" />
                        <TextBlock Margin="0,8,0,0" Text="Поворот (угол x y z)" />
                        <TextBox x:Name="RotationBox" Text="0 0 1 0" />
                        <TextBlock Margin="0,8,0,0" Text="Перенос (x y z)" />
                        <TextBox x:Name="TranslationBox" Text="0 0 0" />
                        <TextBlock Margin="0,8,0,0" Text="Косой сдвиг (xy xz yx yz zx zy)" />
                        <TextBox x:Name="ShearBox" Text="0 0 0 0 0 0" />
                        <TextBlock Margin="0,8,0,0" Text="Перспектива (px py pz)" />
                        <TextBox x:Name="PerspectiveBox" Text="0 0 0" />
                        <Button Margin="0,10,0,0" Height="32" Click="ApplyTransformButton_OnClick" Content="Применить преобразования" />
                        <Button Margin="0,6,0,0" Height="28" Click="ResetTransformButton_OnClick" Content="Сбросить преобразования" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <TextBlock FontWeight="SemiBold" Text="Камера" />
                    <TextBlock Margin="0,8,0,0" Text="Поворот по Y" />
                    <Slider x:Name="YawSlider" Minimum="-180" Maximum="180" ValueChanged="CameraSlider_OnValueChanged" />
                    <TextBlock Margin="0,8,0,0" Text="Поворот по X" />
                    <Slider x:Name="PitchSlider" Minimum="-89" Maximum="89" Value="-18" ValueChanged="CameraSlider_OnValueChanged" />
                    <TextBlock Margin="0,8,0,0" Text="Расстояние" />
                    <Slider x:Name="DistanceSlider" Minimum="300" Maximum="1500" Value="700" ValueChanged="CameraSlider_OnValueChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="8">
            <Viewport3D x:Name="SceneViewport" ClipToBounds="True">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="MainCamera" FieldOfView="60" UpDirection="0,1,0" />
                </Viewport3D.Camera>
            </Viewport3D>
        </Border>
    </Grid>
</Window>
