<Window x:Class="Geometry.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Geometry.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="200" MaxWidth="200"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        
        <StackPanel Grid.Column="0">
            <TextBlock  FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center">Операции</TextBlock>
            <Separator BorderThickness="6" BorderBrush="Black"></Separator>
            <Expander FontSize="16" Header="Масштабирование">
                <StackPanel>
                    <TextBox Margin="5,5,5,0"></TextBox>
                    <Button Margin="5,5,5,0">afdsf</Button>
                </StackPanel>
            </Expander>
            
        </StackPanel>

        <Canvas x:Name="Canvas" Grid.Column="1">
            <Polyline Points="10,10 50,20, 30,30" Stroke="Black"></Polyline>
            <Polyline Points="40,40 100,50, 110,100" Stroke="Red"></Polyline>
        </Canvas>
    </Grid>
</Window>
