<Window x:Class="Geometry.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Geometry.UI"
        xmlns:vm="clr-namespace:Geometry.UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="MainWindow"
        MinHeight="300"
        MinWidth="500"
        Height="600"
        Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="200" MaxWidth="200"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="3" Grid.Column="0">
            <Separator BorderThickness="6" BorderBrush="Black"></Separator>
            <TextBlock FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center">Выбор фигуры</TextBlock>
            <Separator BorderThickness="6" BorderBrush="Black"></Separator>

            <ListBox ItemsSource="{Binding Figures}" SelectedItem="{Binding SelectedFigure}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="16" Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            

            <Separator Margin="0,10,0,0" BorderThickness="6" BorderBrush="Black"></Separator>
            <TextBlock FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center">Операции</TextBlock>
            <Separator BorderThickness="6" BorderBrush="Black"></Separator>

            
            <Expander IsEnabled="{Binding IsAvailable}" FontSize="16" Header="Масштабирование">
                <DockPanel Margin="0,10,0,10" HorizontalAlignment="Left">
                    <TextBox Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" Height="24" Width="150" DockPanel.Dock="Left"/>
                    <Button Command="{Binding ScaleUpCommand}" Width="25" FontSize="6" DockPanel.Dock="Top">▲</Button>
                    <Button Command="{Binding ScaleDownCommand}" Width="25" FontSize="6" DockPanel.Dock="Bottom">▼</Button>
                </DockPanel>
            </Expander>

            <Expander IsEnabled="{Binding IsAvailable}" FontSize="16" Header="Поворот">
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center" Grid.Column="0">
                        <TextBlock HorizontalAlignment="Center" Grid.Row="0">X</TextBlock>
                        <Slider Grid.Row="1"
                                Height="200"
                                Minimum="-180"
                                Maximum="180"
                                Value="{Binding XAngle, UpdateSourceTrigger=PropertyChanged}"
                                AutoToolTipPlacement="TopLeft"
                                Orientation="Vertical"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Grid.Column="1">
                        <TextBlock HorizontalAlignment="Center" Grid.Row="0">Y</TextBlock>
                        <Slider Grid.Row="1"
                                Grid.Column="1"
                                Height="200"
                                Minimum="-180"
                                Maximum="180"
                                Value="{Binding YAngle, UpdateSourceTrigger=PropertyChanged}"
                                AutoToolTipPlacement="TopLeft" Orientation="Vertical"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Grid.Column="2">
                        <TextBlock HorizontalAlignment="Center" Grid.Row="0">Z</TextBlock>
                        <Slider Grid.Row="1"
                                Grid.Column="2"
                                Height="200"
                                Minimum="-180"
                                Maximum="180"
                                Value="{Binding ZAngle, UpdateSourceTrigger=PropertyChanged}"
                                AutoToolTipPlacement="TopLeft"
                                Orientation="Vertical"/>
                    </StackPanel>

                </Grid>
            </Expander>

            <Expander IsEnabled="{Binding IsAvailable}" FontSize="16" Header="Перенос">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.1*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0">X</TextBlock>
                    <TextBox Text="{Binding TranslateX}" Grid.Row="0" Grid.Column="1"></TextBox>

                    <TextBlock Grid.Row="1" Grid.Column="0">Y</TextBlock>
                    <TextBox Text="{Binding TranslateY}" Grid.Row="1" Grid.Column="1"></TextBox>

                    <TextBlock Grid.Row="2" Grid.Column="0">Z</TextBlock>
                    <TextBox Text="{Binding TranslateZ}" Grid.Row="2" Grid.Column="1"></TextBox>

                    <Button Command="{Binding TranslateCommand}" Grid.Row="3" Margin="0,5,0,0" Grid.Column="1">Перенести</Button>
                </Grid>
            </Expander>

            <Expander IsEnabled="{Binding IsAvailable}" FontSize="16" Header="Сдвиг">
                <StackPanel>
                    <TextBox Text="{Binding Shear}" Margin="5"></TextBox>
                    <Button Command="{Binding ShearCommand}" Margin="5,0,5,0">Сдвинуть</Button>
                </StackPanel>
            </Expander>

            <Expander IsEnabled="{Binding IsAvailable}" FontSize="16" Header="ОПП" ToolTip="Одноточечное перспективное преобразование">
                <StackPanel>
                    <TextBox Text="{Binding Perspective}" Margin="5"></TextBox>
                    <Button Command="{Binding PerspectiveCommand}" Margin="5,0,5,0">Спроецировать</Button>
                </StackPanel>
            </Expander>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Lines}" Grid.Column="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Line X1="{Binding X1}" 
                          Y1="{Binding Y1}" 
                          X2="{Binding X2}" 
                          Y2="{Binding Y2}"
                          Stroke ="Black"
                          StrokeThickness="3" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
