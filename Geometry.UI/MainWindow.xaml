<Window x:Class="Geometry.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Geometry.UI"
        xmlns:vm="clr-namespace:Geometry.UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="MainWindow"
        MinHeight="300"
        MinWidth="500"
        Height="900"
        Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="250" MaxWidth="250"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="3" Grid.Column="0">
                <Separator BorderThickness="6" BorderBrush="Black"></Separator>
                <TextBlock FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center">Добавить фигуру</TextBlock>
                <Separator BorderThickness="6" BorderBrush="Black"></Separator>

                <ListView ItemsSource="{Binding FiguresYaml}" SelectedItem="{Binding SelectedYamlFigure}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="16" Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Margin="5,5,5,0" Command="{Binding AddFigureCommand}">Добавить фигуру</Button>

                <Separator BorderThickness="6" Margin="0,10,0,0" BorderBrush="Black"></Separator>
                <TextBlock FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center">Список фигур</TextBlock>
                <Separator BorderThickness="6" BorderBrush="Black"></Separator>

                <ListView ItemsSource="{Binding Figures}" SelectedItem="{Binding SelectedFigure}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock FontSize="16" Text="{Binding Id}"/>
                                <TextBlock Margin="5,0,0,0" FontSize="16" Text="{Binding Name}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button Margin="5,5,5,0" Command="{Binding RemoveFigureCommand}">Удалить фигуру</Button>

                <Separator Margin="0,10,0,0" BorderThickness="6" BorderBrush="Black"></Separator>
                <TextBlock FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center">Операции</TextBlock>
                <Separator BorderThickness="6" BorderBrush="Black"></Separator>

                <Expander IsEnabled="{Binding IsAvailable}" FontSize="16" Header="Масштабирование">
                    <StackPanel>
                        <TextBox  Margin="5" Text="{Binding Scale}"/>
                        <Button  Margin="5,0,5,0" Command="{Binding ChangeScaleCommand}">Масштабировать</Button>
                    </StackPanel>
                </Expander>

                <Expander IsEnabled="{Binding IsAvailable}" FontSize="16" Header="Поворот">
                    <Grid Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <StackPanel HorizontalAlignment="Center" Grid.Column="0">
                            <TextBlock HorizontalAlignment="Center" Grid.Row="0">X</TextBlock>
                            <Slider Grid.Row="1"
                                Height="200"
                                Minimum="-180"
                                Maximum="180"
                                Value="{Binding XAngle}"
                                AutoToolTipPlacement="TopLeft"
                                Orientation="Vertical"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Grid.Column="1">
                            <TextBlock HorizontalAlignment="Center" Grid.Row="0">Y</TextBlock>
                            <Slider Grid.Row="1"
                                Grid.Column="1"
                                Height="200"
                                Minimum="-180"
                                Maximum="180"
                                Value="{Binding YAngle}"
                                AutoToolTipPlacement="TopLeft" Orientation="Vertical"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Grid.Column="2">
                            <TextBlock HorizontalAlignment="Center" Grid.Row="0">Z</TextBlock>
                            <Slider Grid.Row="1"
                                Grid.Column="2"
                                Height="200"
                                Minimum="-180"
                                Maximum="180"
                                Value="{Binding ZAngle}"
                                AutoToolTipPlacement="TopLeft"
                                Orientation="Vertical"/>
                        </StackPanel>

                    </Grid>
                </Expander>

                <Expander IsEnabled="{Binding IsAvailable}" FontSize="16" Header="Перенос">
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.1*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0">X</TextBlock>
                        <TextBox Text="{Binding TranslateX}" Grid.Row="0" Grid.Column="1"></TextBox>

                        <TextBlock Grid.Row="1" Grid.Column="0">Y</TextBlock>
                        <TextBox Text="{Binding TranslateY}" Grid.Row="1" Grid.Column="1"></TextBox>

                        <TextBlock Grid.Row="2" Grid.Column="0">Z</TextBlock>
                        <TextBox Text="{Binding TranslateZ}" Grid.Row="2" Grid.Column="1"></TextBox>

                        <Button Command="{Binding TranslateCommand}" Grid.Row="3" Margin="0,5,0,0" Grid.Column="1">Перенести</Button>
                    </Grid>
                </Expander>

                <Expander IsEnabled="{Binding IsAvailable}" FontSize="16" Header="Сдвиг">
                    <StackPanel>
                        <TextBox Text="{Binding Shear}" Margin="5"></TextBox>
                        <Button Command="{Binding ShearCommand}" Margin="5,0,5,0">Сдвинуть</Button>
                    </StackPanel>
                </Expander>

                <Expander IsEnabled="{Binding IsAvailable}" FontSize="16" Header="ОПП" ToolTip="Одноточечное перспективное преобразование">
                    <StackPanel Margin="0,5,0,0">
                        <TextBlock Margin="5,0,5,0" FontSize="12">Точка схода на оси +X:</TextBlock>
                        <TextBox Text="{Binding Perspective}" Margin="5"></TextBox>

                        <Button Margin="5" Command="{Binding PerspectiveCommand}">Спроектировать</Button>
                    </StackPanel>
                </Expander>
                <Expander IsEnabled="{Binding IsAvailable}" FontSize="16" Header="Вписывание">
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.3*"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="0.3*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Margin="0,0,0,5" FontSize="12" Grid.Row="0" Grid.ColumnSpan="4">Координаты области</TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="0">X1</TextBlock>
                        <TextBox Text="{Binding AreaX1}" Width="60" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1"></TextBox>

                        <TextBlock Grid.Row="2" Grid.Column="0">Y1</TextBlock>
                        <TextBox Text="{Binding AreaY1}" Width="60" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="1"></TextBox>

                        <TextBlock Grid.Row="1" Grid.Column="2">X2</TextBlock>
                        <TextBox Text="{Binding AreaX2}" Width="60" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="3"></TextBox>

                        <TextBlock Grid.Row="2" Grid.Column="2">Y2</TextBlock>
                        <TextBox Text="{Binding AreaY2}" Width="60" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="3"></TextBox>

                        <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                                  IsChecked="False"
                                  Command="{Binding ChangeAreaVisibilityCommand}"
                                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                  VerticalContentAlignment="Center"
                                  HorizontalAlignment="Center">Показать область</CheckBox>

                        <Button Command="{Binding MoveToAreaCommand}" Grid.Row="5" Grid.ColumnSpan="3" Margin="0,5,0,0" Grid.Column="1">Вписать</Button>
                    </Grid>
                </Expander>
                <Expander IsEnabled="{Binding IsAvailable}" FontSize="16" Header="Движение">
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.1*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0">X</TextBlock>
                        <TextBox Text="{Binding AnimationX}" Grid.Row="0" Grid.Column="1"></TextBox>

                        <TextBlock Grid.Row="1" Grid.Column="0">Y</TextBlock>
                        <TextBox Text="{Binding AnimationY}" Grid.Row="1" Grid.Column="1"></TextBox>

                        <TextBlock Grid.Row="2" Grid.Column="0">Z</TextBlock>
                        <TextBox Text="{Binding AnimationZ}" Grid.Row="2" Grid.Column="1"></TextBox>

                        <StackPanel Grid.Row="3"  Grid.Column="1">
                            <Button Command="{Binding StartAnimationCommand}" Margin="0,5,0,0">Начать движение</Button>
                            <Button Command="{Binding StopAnimationCommand}" Margin="0,5,0,0">Остановить движение</Button>
                        </StackPanel>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Canvas Panel.ZIndex="1" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1">
            <Rectangle Visibility="{Binding IsAreaVisible}"
                       Canvas.Bottom="{Binding AreaY1}"
                       Canvas.Left="{Binding AreaX1}"
                       Width="{Binding AreaWidth}"
                       Height="{Binding AreaHeight}"
                       Stroke="Black" StrokeThickness="2"  Fill="Aqua" Opacity="0.5"/>
        </Canvas>
        <ItemsControl Background="WhiteSmoke" ItemsSource="{Binding Lines}" Grid.Column="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Line X1="{Binding X1}" 
                          Y1="{Binding Y1}" 
                          X2="{Binding X2}" 
                          Y2="{Binding Y2}"
                          Stroke ="Black"
                          StrokeThickness="3" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
