<Window x:Class="Geometry.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Z-buffer Viewport3D"
        Width="1280"
        Height="780"
        MinWidth="1050"
        MinHeight="680">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Фигуры" />
                    <TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Foreground="#4B5563"
                           Text="Загрузка фигур из YAML (включая BSP). Для каждой фигуры можно по отдельности применять преобразования." />
                    <TextBlock FontWeight="SemiBold" Text="Доступные описания" />
                    <ListBox x:Name="AvailableFiguresList" Height="120" Margin="0,8,0,12" DisplayMemberPath="Name" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LoadFigureButton" Width="120" Height="32" Click="LoadFigureButton_OnClick" Content="Добавить" />
                        <Button x:Name="RemoveFigureButton" Margin="8,0,0,0" Width="120" Height="32" Click="RemoveFigureButton_OnClick" Content="Удалить" />
                    </StackPanel>

                    <Separator Margin="0,16,0,16" />
                    <TextBlock FontWeight="SemiBold" Text="Загруженные фигуры" />
                    <ListBox x:Name="LoadedFiguresList" Height="120" Margin="0,8,0,0" DisplayMemberPath="DisplayName" SelectionChanged="LoadedFiguresList_OnSelectionChanged" />

                    <Separator Margin="0,16,0,16" />
                    <TextBlock FontWeight="SemiBold" Text="Преобразования выбранной фигуры" />

                    <TextBlock Margin="0,8,0,0" Text="Масштаб (x y z)" />
                    <DockPanel>
                        <TextBox x:Name="ScaleBox" Text="1 1 1" />
                        <Button Margin="8,0,0,0" Width="110" Content="Применить" Click="ApplyScaleButton_OnClick" />
                    </DockPanel>

                    <TextBlock Margin="0,8,0,0" Text="Поворот (угол x y z)" />
                    <DockPanel>
                        <TextBox x:Name="RotationBox" Text="0 0 1 0" />
                        <Button Margin="8,0,0,0" Width="110" Content="Применить" Click="ApplyRotationButton_OnClick" />
                    </DockPanel>

                    <TextBlock Margin="0,8,0,0" Text="Перенос (x y z)" />
                    <DockPanel>
                        <TextBox x:Name="TranslationBox" Text="0 0 0" />
                        <Button Margin="8,0,0,0" Width="110" Content="Применить" Click="ApplyTranslationButton_OnClick" />
                    </DockPanel>

                    <TextBlock Margin="0,8,0,0" Text="Косой сдвиг (xy xz yx yz zx zy)" />
                    <DockPanel>
                        <TextBox x:Name="ShearBox" Text="0 0 0 0 0 0" />
                        <Button Margin="8,0,0,0" Width="110" Content="Применить" Click="ApplyShearButton_OnClick" />
                    </DockPanel>

                    <TextBlock Margin="0,8,0,0" Text="Перспектива (px py pz)" />
                    <DockPanel>
                        <TextBox x:Name="PerspectiveBox" Text="0 0 0" />
                        <Button Margin="8,0,0,0" Width="110" Content="Применить" Click="ApplyPerspectiveButton_OnClick" />
                    </DockPanel>

                    <Button Margin="0,10,0,0" Height="30" Click="ResetTransformButton_OnClick" Content="Сбросить все преобразования" />

                    <Separator Margin="0,16,0,16" />
                    <TextBlock FontWeight="SemiBold" Text="Управление камерой" />
                    <Border Margin="0,6,0,0" Padding="8" Background="#F3F4F6" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="• Колесо мыши: приближение / отдаление" />
                            <TextBlock Text="• Правая кнопка + движение: вращение" />
                            <TextBlock Text="• Нажатое колесико + движение: перемещение" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Padding="12" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="8">
            <Viewport3D x:Name="SceneViewport"
                        ClipToBounds="True"
                        Focusable="True"
                        MouseWheel="SceneViewport_OnMouseWheel"
                        MouseDown="SceneViewport_OnMouseDown"
                        MouseMove="SceneViewport_OnMouseMove"
                        MouseUp="SceneViewport_OnMouseUp">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="MainCamera" FieldOfView="60" UpDirection="0,1,0" />
                </Viewport3D.Camera>
            </Viewport3D>
        </Border>
    </Grid>
</Window>
