<Window x:Class="Geometry.OctreeUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Geometry.OctreeUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель управления -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <GroupBox Header="Управление" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="Минимальный размер октанта:" Margin="0,5"/>
                        <Slider x:Name="MinSizeSlider" Minimum="0.1" Maximum="2.0" Value="1" 
                               TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,5"/>
                        <TextBlock x:Name="MinSizeText" Text="1" HorizontalAlignment="Center"/>

                        <Button x:Name="ClearVisualization" Content="Очистить визуализацию" Margin="0,10" Click="ClearVisualization_Click"/>
                        <Button x:Name="CameraReset" Click="CameraReset_Click">Сбросить камеру</Button>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,0,0,10" Header="Параметры параллелепипеда">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="14" Margin="5" Grid.Row="0">Центр:</TextBlock>
                        <StackPanel Margin="5" Grid.Row="1">
                            <TextBlock>X:</TextBlock>
                            <TextBox x:Name="BoxX"/>
                            <TextBlock>Y:</TextBlock>
                            <TextBox x:Name="BoxY"/>
                            <TextBlock>Z:</TextBlock>
                            <TextBox x:Name="BoxZ"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="5">
                            <TextBlock>Длина:</TextBlock>
                            <TextBox x:Name="BoxLength"/>
                            <TextBlock>Ширина:</TextBlock>
                            <TextBox x:Name="BoxWidth"/>
                            <TextBlock>Высота:</TextBlock>
                            <TextBox x:Name="BoxHeight"/>

                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="5">
                            <Button x:Name="BuildBox" Click="BuildBox_Click">Построить</Button>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Margin="0,0,0,10" Header="Параметры шара">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="14" Margin="5" Grid.Row="0">Центр:</TextBlock>

                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock>X:</TextBlock>
                            <TextBox x:Name="SphereX"/>
                            <TextBlock>Y:</TextBlock>
                            <TextBox x:Name="SphereY"/>
                            <TextBlock>Z:</TextBlock>
                            <TextBox x:Name="SphereZ"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="5">
                            <TextBlock>Радиус:</TextBlock>
                            <TextBox x:Name="SphereRadius"/>

                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="5">
                            <Button x:Name="BuildSphere" Click="BuildSphere_Click">Построить</Button>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Объем Octree" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock x:Name="SphereVolume" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BoxVolume" TextWrapping="Wrap"/>

                        <Button Margin="0,10,0,0" x:Name="GetVolume" Click="GetVolume_Click">Вычислить объем</Button>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Проверка точки" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock>X:</TextBlock>
                        <TextBox x:Name="TestX"/>
                        <TextBlock>Y:</TextBlock>
                        <TextBox x:Name="TestY"/>
                        <TextBlock>Z:</TextBlock>
                        <TextBox x:Name="TestZ"/>

                        <Button x:Name="GetPoint" Margin="0,10,0,0" Click="GetPoint_Click">Вычислить</Button>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Булевы операции" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Button x:Name="SubtractButton" Content="Вычитание" Margin="0,2"/>
                        <Button x:Name="IntersectButton" Content="Пересечение" Margin="0,2"/>
                        <Button x:Name="ResetButton" Content="Сброс к исходным" Margin="0,10,0,2"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        
        <Viewport3D
            MouseDown="Viewport_MouseDown"
            MouseUp="Viewport_MouseUp" 
            MouseMove="Viewport_MouseMove"
            MouseWheel="Viewport_MouseWheel"
            Grid.Column="1"
            x:Name="MainViewport">

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <AmbientLight Color="White"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <DirectionalLight Color="White" Direction="1,-1,-1"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
    </Grid>
</Window>
