<Window x:Class="Geometry.OctreeUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Geometry.OctreeUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <Expander IsExpanded="True" Header="Управление" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="Минимальный размер куба:" Margin="0,5"/>
                        <Slider x:Name="MinSizeSlider" Minimum="0.1" Maximum="2.0" Value="1" 
                               TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,5"/>
                        <TextBlock x:Name="MinSizeText" Text="1" HorizontalAlignment="Center"/>

                        <Button x:Name="ClearVisualization" Content="Очистить визуализацию" Margin="0,10" Click="ClearVisualization_Click"/>
                        <Button x:Name="CameraReset" Click="CameraReset_Click">Сбросить камеру</Button>
                    </StackPanel>
                </Expander>

                <Expander IsExpanded="True" Margin="0,0,0,10" Header="Параметры цилиндра">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="14" Margin="5" Grid.Row="0">Центр:</TextBlock>
                        <StackPanel Margin="5" Grid.Row="1">
                            <TextBlock>X:</TextBlock>
                            <TextBox x:Name="CylinderX"/>
                            <TextBlock>Y:</TextBlock>
                            <TextBox x:Name="CylinderY"/>
                            <TextBlock>Z:</TextBlock>
                            <TextBox x:Name="CylinderZ"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="5">
                            <TextBlock>Радиус:</TextBlock>
                            <TextBox x:Name="CylinderRadius"/>
                            <TextBlock>Высота:</TextBlock>
                            <TextBox x:Name="CylinderHeight"/>

                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="5">
                            <Button x:Name="BuildCylinder" Click="BuildCylinder_Click">Добавить</Button>
                        </StackPanel>
                    </Grid>
                </Expander>

                <Expander IsExpanded="True" Margin="0,0,0,10" Header="Параметры шара">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="14" Margin="5" Grid.Row="0">Центр:</TextBlock>

                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock>X:</TextBlock>
                            <TextBox x:Name="SphereX"/>
                            <TextBlock>Y:</TextBlock>
                            <TextBox x:Name="SphereY"/>
                            <TextBlock>Z:</TextBlock>
                            <TextBox x:Name="SphereZ"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="5">
                            <TextBlock>Радиус:</TextBlock>
                            <TextBox x:Name="SphereRadius"/>

                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="5">
                            <Button x:Name="BuildSphere" Click="BuildSphere_Click">Добавить</Button>
                        </StackPanel>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Viewport3D
            MouseDown="Viewport_MouseDown"
            MouseUp="Viewport_MouseUp" 
            MouseMove="Viewport_MouseMove"
            MouseWheel="Viewport_MouseWheel"
            Grid.Column="1"
            x:Name="MainViewport"/>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            
            
            <StackPanel Margin="10">
                <ListView ItemsSource="{Binding OctreeModels}" x:Name="ModelsList" Margin="0,10,0,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn DisplayMemberBinding="{Binding Path=Name}" Header="Объект" Width="100">
                            </GridViewColumn>
                            <GridViewColumn DisplayMemberBinding="{Binding Path=Position}" Header="Координаты">
                            </GridViewColumn>
                            <GridViewColumn DisplayMemberBinding="{Binding Path=Volume}" Header="Объем" Width="80">
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Button x:Name="RemoveObject" Margin="0,5,0,0" Click="RemoveObject_Click">Удалить объект</Button>

                <Expander Header="Проверка точки" Margin="0,10,0,10">
                    <StackPanel Margin="5">
                        <TextBlock>Объект:</TextBlock>
                        <ComboBox Margin="0,0,0,10" ItemsSource="{Binding OctreeModels}" x:Name="TestPointObject">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock>X:</TextBlock>
                        <TextBox x:Name="TestX"/>
                        <TextBlock>Y:</TextBlock>
                        <TextBox x:Name="TestY"/>
                        <TextBlock>Z:</TextBlock>
                        <TextBox x:Name="TestZ"/>

                        <Button x:Name="GetPoint" Margin="0,10,0,0" Click="GetPoint_Click">Вычислить</Button>
                    </StackPanel>
                </Expander>

                <Expander Header="Булевы операции" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock>Первый объект:</TextBlock>
                         <ComboBox ItemsSource="{Binding OctreeModels}" x:Name="FirstObject">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                         </ComboBox>

                         <TextBlock Margin="0,5,0,0">Второй объект:</TextBlock>
                         <ComboBox ItemsSource="{Binding OctreeModels}" x:Name="SecondObject">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                         </ComboBox>

                        <Button Margin="0,10,0,0" MinHeight="25" x:Name="UnionButton" Content="Объединить" Click="UnionButton_Click"/>
                        <Button Margin="0,5,0,0" MinHeight="25" x:Name="IntersectButton" Content="Пересечь" Click="IntersectButton_Click"/>
                        <Button Margin="0,5,0,0" MinHeight="25" x:Name="SubtractButton" Content="Вычесть" Click="SubtractButton_Click"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
